# Uso LOCAL (padrão). Dados reais não são publicados por estes valores.
PORT=3210
FINANCE_DATA_DIR=
FINANCE_PYTHON=
NEXT_TELEMETRY_DISABLED=1
# Hospedagem OPCIONAL: configure somente nos segredos privados do provedor.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
# DATABASE_URL deve usar somente o login restrito do app.
# MIGRATION_DATABASE_URL é exclusiva da sessão local do operador (npm run migrate:db).
# Nunca configure a conexão administrativa nos ambientes Vercel/CI.
# APP_ORIGIN=https://SEU-PROJETO.vercel.app
# SETUP_TOKEN=SEGREDO_ALEATORIO_COM_NO_MINIMO_32_CARACTERES
# PARSER_TOKEN=OUTRO_SEGREDO_ALEATORIO_COM_NO_MINIMO_32_CARACTERES
# Nunca coloque credenciais reais neste exemplo ou no controle de versão.
# BACKUP_PASSWORD: apenas na sessão privada do terminal.
# IA externa OPCIONAL. Desligada por padrão; ajuda local independe dela.
# Configure somente após decidir privacidade, modelo e limite de gastos.
# AI_PROVIDER=openai
# OPENAI_API_KEY=CONFIGURAR_COMO_SEGREDO_NO_SERVIDOR
# OPENAI_MODEL=MODELO_ESCOLHIDO_NA_CONTA_DO_PROVEDOR
# Alternativa recomendada com cota gratuita: Groq Free Plan.
# Não ative faturamento ou troca automática para serviço pago.
# AI_PROVIDER=groq
# GROQ_API_KEY=CONFIGURAR_COMO_SEGREDO_NO_SERVIDOR
# GROQ_MODEL=openai/gpt-oss-120b
# Marcar true SOMENTE após ativar Zero Data Retention na conta Groq.
# GROQ_ZDR_CONFIRMED=true

# Meu Pluggy: chave dedicada AES-256 (32 bytes aleatórios em base64), apenas no servidor.
# BANK_CONNECTIONS_KEY=CONFIGURAR_SOMENTE_NOS_SEGREDOS_DA_HOSPEDAGEM
# Preserve essa chave: trocá-la sem recriptografar as credenciais impede futuras leituras.

# CRON_SECRET=
